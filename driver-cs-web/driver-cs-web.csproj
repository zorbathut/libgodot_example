<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <WasmNativeStrip>false</WasmNativeStrip>
      <EmccExtraLDFlags>
          -sEXPORTED_FUNCTIONS=_libgodot_create_godot_instance,_libgodot_destroy_godot_instance,_malloc,_free,_sbrk,_memalign,_memset,_memcpy,_memmove,_gdext_wrapper_set_proc_address,_gdext_wrapper_load_interface,_gdext_wrapper_string_name_new,_gdext_wrapper_classdb_get_method_bind,_gdext_wrapper_object_method_bind_ptrcall,_gdext_wrapper_object_get_instance_id,stackSave,stackRestore,stackAlloc
          -sUSE_WEBGL2=1
          -sFULL_ES3=1
    
          -lidbfs.js
          -sFORCE_FILESYSTEM=1
          
          --js-library=../godot/platform/web/js/libs/library_godot_audio.js
          --js-library=../godot/platform/web/js/libs/library_godot_display.js
          --js-library=../godot/platform/web/js/libs/library_godot_fetch.js
          --js-library=../godot/platform/web/js/libs/library_godot_input.js
          --js-library=../godot/platform/web/js/libs/library_godot_javascript_singleton.js
          --js-library=../godot/platform/web/js/libs/library_godot_os.js
          --js-library=../godot/platform/web/js/libs/library_godot_runtime.js
          --js-library=../godot/platform/web/js/libs/library_godot_webgl2.js
          --js-library=../godot/platform/web/js/libs/library_godot_webmidi.js
    
          --js-library=../godot/modules/webrtc/library_godot_webrtc.js
          --js-library=../godot/modules/websocket/library_godot_websocket.js
          --js-library=../godot/modules/webxr/native/library_godot_webxr.js
      </EmccExtraLDFlags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the Godot C# API assemblies -->
    <Reference Include="GodotSharp">
      <HintPath>../godot/bin/GodotSharp/Api/Release/GodotSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!-- Link Godot static library -->
    <NativeFileReference Include="../godot/bin/libgodot.web.template_release.wasm32.nothreads.cs_webexport.a" />

    <!-- C wrapper for GDExtension function pointer calls (WASM trampoline workaround) -->
    <NativeFileReference Include="gdextension_wrappers.c" />
  </ItemGroup>
</Project>
